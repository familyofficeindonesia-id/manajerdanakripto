{# Navigasi antar halaman daftar #}
{%- if total_halaman > 1 %}
<nav class="paginasi" aria-label="Navigasi halaman">
  {%- if halaman_ini > 1 %}
  <a href="{{ url_halaman(halaman_ini - 1) }}" rel="prev">‹ Sebelumnya</a>
  {%- endif %}
  {%- for n in range(1, total_halaman + 1) %}
    {%- if n == halaman_ini %}
    <span aria-current="page">{{ n }}</span>
    {%- elif n <= 2 or n > total_halaman - 2 or (n - halaman_ini) | abs <= 1 %}
    <a href="{{ url_halaman(n) }}">{{ n }}</a>
    {%- elif (n - halaman_ini) | abs == 2 %}
    <span aria-hidden="true">…</span>
    {%- endif %}
  {%- endfor %}
  {%- if halaman_ini < total_halaman %}
  <a href="{{ url_halaman(halaman_ini + 1) }}" rel="next">Berikutnya ›</a>
  {%- endif %}
</nav>
{%- endif %}
