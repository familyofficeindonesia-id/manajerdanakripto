{% extends "base.html.j2" %}
{% block konten %}
<section class="bagian">
  <div class="bungkus">
    <header style="max-width:60ch;margin-bottom:var(--sp-6)">
      <span class="eyebrow">{{ eyebrow | default('Rubrik') }}</span>
      <h1 style="font-size:var(--t-h1);margin-block:var(--sp-3)">{{ halaman.judul }}</h1>
      {%- if halaman.deskripsi %}
      <p style="font-family:var(--serif);font-size:1.125rem;color:var(--tinta-lembut)">{{ halaman.deskripsi }}</p>
      {%- endif %}
      <p class="meta">{{ total_artikel }} artikel{% if total_halaman > 1 %} · halaman {{ halaman_ini }} dari {{ total_halaman }}{% endif %}</p>
    </header>

    {%- if artikel %}
    <div class="kisi kisi--3">
      {%- for a in artikel %}{% include "partials/kartu.html.j2" %}{% endfor %}
    </div>
    {% include "partials/paginasi.html.j2" %}
    {%- else %}
    <p class="hasil-kosong">Belum ada artikel pada bagian ini. Jalankan pipeline berita untuk mengisi halaman.</p>
    {%- endif %}
  </div>
</section>
{% endblock %}
