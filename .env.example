# Salin berkas ini menjadi .env lalu isi nilainya.
# .env TIDAK boleh dikomit ke repositori.

# Kunci API Anthropic — diperlukan untuk tahap `tulis`.
# Dapatkan di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional — dipakai bila Anda mengaktifkan analitik pada config/settings.yaml
GOOGLE_ANALYTICS_ID=

# =============================================================================
# RADAR — kanal notifikasi (semua opsional)
# Aktifkan kanal yang dipakai pada blok `radar.kanal` di config/settings.yaml.
# =============================================================================

# --- Telegram (paling praktis untuk peringatan langsung) ---------------------
# 1. Buat bot lewat @BotFather, salin tokennya.
# 2. Kirim satu pesan ke bot Anda, lalu buka:
#    https://api.telegram.org/bot<TOKEN>/getUpdates untuk membaca chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook generik (Slack, Discord, n8n, Zapier, Make) ---------------------
# Gaya: generik | slack | discord
RADAR_WEBHOOK_URL=
RADAR_WEBHOOK_GAYA=generik

# --- Surel ringkasan ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RADAR_EMAIL_DARI=
RADAR_EMAIL_KE=            # pisahkan beberapa alamat dengan koma

# --- WhatsApp Business API ---------------------------------------------------
# Isi sesuai penyedia Anda (Meta Cloud API atau penyedia lokal).
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TUJUAN=           # nomor tujuan format internasional, tanpa tanda plus
