name: Radar — pantau sumber berita

# GitHub Actions menjalankan cron dengan toleransi beberapa menit dan dapat
# menunda saat beban tinggi. Untuk pemantauan yang benar-benar rapat, jalankan
# `mdk radar jaga` pada server sendiri (lihat deploy/mdk-radar.service).
on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: radar
  cancel-in-progress: true

jobs:
  pantau:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: Pulihkan riwayat radar
        uses: actions/cache/restore@v4
        with:
          path: data/mdk.sqlite3
          key: mdk-db-${{ github.run_id }}
          restore-keys: mdk-db-

      - name: Bangun daftar sumber bila belum ada
        env:
          PYTHONPATH: src
        run: |
          test -f config/watchlist.yaml || python -m mdk radar bangun

      - name: Satu putaran pemantauan
        env:
          PYTHONPATH: src
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          RADAR_WEBHOOK_URL: ${{ secrets.RADAR_WEBHOOK_URL }}
          RADAR_WEBHOOK_GAYA: ${{ vars.RADAR_WEBHOOK_GAYA || 'generik' }}
        run: python -m mdk radar pantau --teruskan

      - name: Ringkasan
        if: always()
        env:
          PYTHONPATH: src
        run: |
          {
            echo '### Radar'
            echo '```'
            python -m mdk radar status --batas 12
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Simpan riwayat radar
        uses: actions/cache/save@v4
        if: always()
        with:
          path: data/mdk.sqlite3
          key: mdk-db-${{ github.run_id }}
